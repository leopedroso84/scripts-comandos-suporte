#define name Escala Alarme
#define version 26

#include 'actions/calendar'
#include 'actions/math'
#include 'actions/text'

enum timeBetweenUnit {
    'Seconds'
}

action 'gettimebetweendates' getTimeBetweenDates(
    text input: 'WFInput',
    text fromDate: 'WFTimeUntilFromDate',
    timeBetweenUnit unit: 'WFTimeUntilUnit'
): number

/*
Busca uma janela curta. A validacao exata de data e feita logo depois,
comparando yyyy-MM-dd do evento com yyyy-MM-dd de amanha.
Assim, mesmo que o iOS renderize a janela como varios dias, somente
um evento de AMANHA pode alterar o alarme.
*/
action 'filter.calendarevents' getNearCalendarEvents(): array {
    "WFContentItemFilter": {
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFActionParameterFilterTemplates": [
                {
                    "Operator": 1000,
                    "Property": "Start Date",
                    "Removable": true,
                    "Values": {
                        "Number": 1,
                        "Unit": 16384
                    }
                }
            ],
            "WFContentPredicateBoundedDate": false
        },
        "WFSerializationType": "WFContentPredicateTableTemplate"
    },
    "WFContentItemSortOrder": "Oldest First",
    "WFContentItemSortProperty": "Start Date"
}

comment('ESCALA ALARME - versao enxuta v2. Ancora do ciclo: segunda-feira 17/08/2026. Ciclo: 7 dias de plantao + 14 dias sem plantao. Executar diariamente as 22:00 para preparar AMANHA.')

/* DATA E CICLO */
const agora = currentDate()
const amanha = adjustDate("{agora}", "Add", qty(1, "days"))
const amanhaData = formatDate("{amanha}", "Custom", "yyyy-MM-dd")
const dataBase = date("2026-08-17")
const epoch = date("1970-01-01")
const amanhaSeg = getTimeBetweenDates("{amanha}", "{epoch}", "Seconds")
const baseSeg = getTimeBetweenDates("{dataBase}", "{epoch}", "Seconds")
const diferencaSeg = amanhaSeg - baseSeg
const diferencaDias = diferencaSeg / 86400
const diasDesdeBase = floor(diferencaDias)
const posCiclo = diasDesdeBase % 21
const diaSemana = posCiclo % 7

@plantao = false
if posCiclo < 7 {
    @plantao = true
}

/*
MODO DO ALARME:
0 = nenhum
1 = 07:00
2 = 07:45

A ancora comeca numa segunda-feira, portanto:
0 seg, 1 ter, 2 qua, 3 qui, 4 sex, 5 sab, 6 dom.
*/
@modo = 0
if @plantao == true {
    if diaSemana < 5 {
        @modo = 1
    }
    if diaSemana == 6 {
        @modo = 2
    }
} else {
    if diaSemana < 6 {
        @modo = 1
    }
}

/* CALENDARIO: UMA REGRA GENERICA DE FERIADO */
@especial = false
@motivo = "dia normal"
@eventos = getNearCalendarEvents()

for evento in @eventos {
    const inicioEvento = getEventDetail(@evento, "Start Date")
    const dataEvento = formatDate("{inicioEvento}", "Custom", "yyyy-MM-dd")

    if dataEvento == amanhaData {
        const calendarioRaw = getEventDetail(@evento, "Calendar")
        @calendario = lowercase("{calendarioRaw}")
        @calendarioFeriado = false

        if @calendario contains "feriado" {
            @calendarioFeriado = true
        }
        if @calendario contains "holiday" {
            @calendarioFeriado = true
        }
        if @calendario contains "jales" {
            @calendarioFeriado = true
        }

        if @calendarioFeriado == true {
            const tituloRaw = getEventDetail(@evento, "Title")
            @titulo = lowercase("{tituloRaw}")
            @ignorar = false

            /* Segunda de Carnaval e dia normal para esta escala. */
            if diaSemana == 0 {
                if @titulo contains "carnaval" {
                    @ignorar = true
                }
            }

            if @ignorar == false {
                @especial = true
                @motivo = "{tituloRaw}"
            }
        }
    }
}

/* Feriado / Carnaval de terca / Cinzas: plantao 07:45; fora do plantao, folga. */
if @especial == true {
    @modo = 0
    if @plantao == true {
        @modo = 2
    }
}

/*
As cinco marcacoes PATCH abaixo sao substituidas no build por acoes
reais colhidas de atalhos atuais do iOS. Isso evita os App Intents
antigos do catalogo do Cherri que o iPhone mostrou como desconhecidos.
*/
comment('PATCH_DESLIGAR_0700')
comment('PATCH_DESLIGAR_0745')

if @modo == 1 {
    comment('PATCH_LIGAR_0700')
}

if @modo == 2 {
    comment('PATCH_LIGAR_0745')
}

comment('PATCH_ATIVAR_SLEEP')

/* Confirmacao silenciosa do que ficou preparado para amanha. */
@resumo = "SEM ALARME"
if @modo == 1 {
    @resumo = "07:00"
}
if @modo == 2 {
    @resumo = "07:45"
}
showNotification("Amanha: {@resumo} • {@motivo}", "Escala Alarme", false)
