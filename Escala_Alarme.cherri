#define name Escala Alarme
#define version 26

#include 'actions/calendar'
#include 'actions/math'
#include 'actions/settings'
#include 'actions/text'

enum timeBetweenUnit {
    'Seconds'
}

action 'gettimebetweendates' getTimeBetweenDates(
    text input: 'WFInput',
    text fromDate: 'WFTimeUntilFromDate',
    timeBetweenUnit unit: 'WFTimeUntilUnit'
): number

action 'filter.calendarevents' getUpcomingCalendarEvents(): array {
    "WFContentItemFilter": {
        "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFActionParameterFilterTemplates": [
                {
                    "Operator": 1000,
                    "Property": "Start Date",
                    "Removable": true,
                    "Values": {
                        "Number": 1,
                        "Unit": 16384
                    }
                }
            ],
            "WFContentPredicateBoundedDate": false
        },
        "WFSerializationType": "WFContentPredicateTableTemplate"
    },
    "WFContentItemSortOrder": "Oldest First",
    "WFContentItemSortProperty": "Start Date"
}

comment('ESCALA ALARME - ciclo de 21 dias. Semana-base de plantao: 17/08/2026 a 23/08/2026. Executar diariamente as 22:00 para preparar o dia seguinte.')

const agora = currentDate()
const amanha = adjustDate("{agora}", "Add", qty(1, "days"))
const dataBase = date("2026-08-17")
const epoch = date("1970-01-01")

const amanhaSeg = getTimeBetweenDates("{amanha}", "{epoch}", "Seconds")
const baseSeg = getTimeBetweenDates("{dataBase}", "{epoch}", "Seconds")
const diferencaSeg = amanhaSeg - baseSeg
const diferencaDias = diferencaSeg / 86400
const diasDesdeBase = floor(diferencaDias)
const posCiclo = diasDesdeBase % 21
const diaCiclo = posCiclo % 7

@posCiclo = number(posCiclo)
@diaCiclo = number(diaCiclo)
@semanaPlantao = false
if @posCiclo < 7 {
    @semanaPlantao = true
}

@alarmMode = 0
if @semanaPlantao == true {
    if @diaCiclo < 5 {
        @alarmMode = 1
    }
    if @diaCiclo == 5 {
        @alarmMode = 0
    }
    if @diaCiclo == 6 {
        @alarmMode = 2
    }
} else {
    if @diaCiclo < 6 {
        @alarmMode = 1
    }
    if @diaCiclo == 6 {
        @alarmMode = 0
    }
}

@eventoEspecial = false
@nomeEspecial = ""
@eventos = getUpcomingCalendarEvents()

for evento in @eventos {
    const tituloRaw = getEventDetail(@evento, "Title")
    @titulo = lowercase("{tituloRaw}")

    const calendarioRaw = getEventDetail(@evento, "Calendar")
    const calendarioNomeRaw = getName(calendarioRaw)
    @calendarioNome = lowercase("{calendarioNomeRaw}")

    @calendarioFeriados = false
    if @calendarioNome contains "feriado" {
        @calendarioFeriados = true
    }
    if @calendarioNome contains "holiday" {
        @calendarioFeriados = true
    }
    if @calendarioNome contains "jales" {
        @calendarioFeriados = true
    }

    if @calendarioFeriados == true {
        @feriadoComum = false

        if @titulo contains "ano novo" { @feriadoComum = true }
        if @titulo contains "confraterniza" { @feriadoComum = true }
        if @titulo contains "paixão" { @feriadoComum = true }
        if @titulo contains "paixao" { @feriadoComum = true }
        if @titulo contains "sexta-feira santa" { @feriadoComum = true }
        if @titulo contains "tiradentes" { @feriadoComum = true }
        if @titulo contains "dia do trabalho" { @feriadoComum = true }
        if @titulo contains "corpus christi" { @feriadoComum = true }
        if @titulo contains "independência do brasil" { @feriadoComum = true }
        if @titulo contains "independencia do brasil" { @feriadoComum = true }
        if @titulo contains "nossa senhora aparecida" { @feriadoComum = true }
        if @titulo contains "finados" { @feriadoComum = true }
        if @titulo contains "proclamação da república" { @feriadoComum = true }
        if @titulo contains "proclamacao da republica" { @feriadoComum = true }
        if @titulo contains "consciência negra" { @feriadoComum = true }
        if @titulo contains "consciencia negra" { @feriadoComum = true }
        if @titulo == "natal" { @feriadoComum = true }
        if @titulo contains "revolução constitucionalista" { @feriadoComum = true }
        if @titulo contains "revolucao constitucionalista" { @feriadoComum = true }
        if @titulo contains "9 de julho" { @feriadoComum = true }
        if @titulo contains "aniversário de jales" { @feriadoComum = true }
        if @titulo contains "aniversario de jales" { @feriadoComum = true }
        if @titulo contains "fundação de jales" { @feriadoComum = true }
        if @titulo contains "fundacao de jales" { @feriadoComum = true }
        if @titulo contains "assunção de nossa senhora" { @feriadoComum = true }
        if @titulo contains "assuncao de nossa senhora" { @feriadoComum = true }

        if @feriadoComum == true {
            @eventoEspecial = true
            @nomeEspecial = "{tituloRaw}"
        }

        if @titulo contains "carnaval" {
            if @diaCiclo == 1 {
                @eventoEspecial = true
                @nomeEspecial = "{tituloRaw}"
            }
        }

        if @titulo contains "cinzas" {
            if @diaCiclo == 2 {
                @eventoEspecial = true
                @nomeEspecial = "{tituloRaw}"
            }
        }
    }
}

if @eventoEspecial == true {
    if @semanaPlantao == true {
        @alarmMode = 2
    } else {
        @alarmMode = 0
    }
}

@alarm0700: variable
@alarm0745: variable
@alarmes = getAlarms()

for alarme in @alarmes {
    const nomeAlarmeRaw = getName(@alarme)
    @nomeAlarme = "{nomeAlarmeRaw}"

    if @nomeAlarme == "Escala 07:00" {
        @alarm0700 = @alarme
    }
    if @nomeAlarme == "Escala 07:45" {
        @alarm0745 = @alarme
    }
}

if @alarm0700 {
    turnOffAlarm(@alarm0700, false)
}
if @alarm0745 {
    turnOffAlarm(@alarm0745, false)
}

if @alarmMode == 1 {
    if @alarm0700 {
        turnOnAlarm(@alarm0700, false)
    } else {
        showNotification("ERRO: alarme 'Escala 07:00' nao foi encontrado.", "Escala Alarme", true)
    }
}

if @alarmMode == 2 {
    if @alarm0745 {
        turnOnAlarm(@alarm0745, false)
    } else {
        showNotification("ERRO: alarme 'Escala 07:45' nao foi encontrado.", "Escala Alarme", true)
    }
}

@fimDormir = "09:00"
if @alarmMode == 1 { @fimDormir = "07:00" }
if @alarmMode == 2 { @fimDormir = "07:45" }
setFocusMode("Sleep", "Time", "{@fimDormir}")

@resumo = "SEM ALARME"
if @alarmMode == 1 { @resumo = "07:00" }
if @alarmMode == 2 { @resumo = "07:45" }

@motivo = "dia normal"
if @eventoEspecial == true { @motivo = "{@nomeEspecial}" }

showNotification("Amanha: {@resumo} • {@motivo}", "Escala Alarme", false)
